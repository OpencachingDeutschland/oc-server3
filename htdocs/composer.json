{
  "_comment": "",
  "name": "opencaching/oc-server",
  "license": "GNU General Public License",
  "description": "opencaching.de source code",
  "config": {
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "php-http/discovery": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "require": {
    "php": ">=8.4.0",
    "beberlei/doctrineextensions": "^1.0",
    "components/jquery": "^3.2",
    "doctrine/doctrine-bundle": "^2.6.4",
    "doctrine/doctrine-migrations-bundle": "^3.0",
    "doctrine/orm": "^2.5",
    "eluceo/ical": "^2.0",
    "endroid/qr-code": "^4.0|^5.0|^6.0",
    "ezyang/htmlpurifier": "^v4.8",
    "jms/translation-bundle": "^1.2",
    "knplabs/knp-menu-bundle": "^3.2",
    "league/commonmark": "^2.0",
    "league/csv": "^9.6",
    "mervick/material-design-icons": "^2.2",
    "nyholm/psr7": "^1.8",
    "opencaching/okapi": "dev-master",
    "scssphp/scssphp": "^1.0.0|^2.0",
    "sensio/framework-extra-bundle": "^6.0",
    "smarty/smarty": "dev-development",
    "symfony/monolog-bundle": "^3.5",
    "symfony/polyfill-apcu": "^1.0",
    "symfony/swiftmailer-bundle": "^3.4",
    "symfony/symfony": "4.4.*",
    "twbs/bootstrap": "^5.0",
    "twig/extensions": "^1.3",
    "ext-gd": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "ext-simplexml": "*",
    "ext-posix": "*",
    "ext-curl": "*",
    "ext-zlib": "*"
  },
  "require-dev": {
    "fig-r/psr2r-sniffer": "2.0",
    "nette/php-generator": "^4.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0",
    "squizlabs/php_codesniffer": "^2.6|^3.0|^4.0",
    "symfony/phpunit-bridge": "^8.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/opencaching/okapi"
    },
    {
      "type": "vcs",
      "url": "git@github.com:OpencachingDeutschland/smarty.git"
    }
  ],
  "autoload": {
    "psr-4": {
      "OcTest\\": "../tests",
      "Oc\\": "src/Oc",
      "": "src/"
    },
    "classmap": [
      "lib2/",
      "lib2/logic/",
      "app/AppKernel.php",
      "app/AppCache.php"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "4.4.*"
    }
  }
}
