{% extends 'app/base.html.twig' %}
{% block title %}OpenCaching{% endblock %}

{% block body %}
<div class="oc-home">

  {# Left column #}
  <div class="oc-home-side">

    {# Short card #}
    <div class="card oc-card mb-3">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-bolt me-1"></i> Schnellzugriff
      </div>
      <div class="card-body d-flex flex-column gap-2">
        <a href="/livemap" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-map me-2"></i>Live-Karte
        </a>
        <a href="/caches/" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-magnifying-glass me-2"></i>Caches suchen
        </a>
        <a href="/newcache" class="btn btn-outline-primary w-100 text-start">
          <i class="fa-solid fa-plus me-2"></i>Cache verstecken
        </a>
      </div>
    </div>

    {# Tall card #}
    <div class="card oc-card">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-circle-question me-1"></i> Was ist Geocaching?
      </div>
      <div class="card-body">
        <ul class="oc-steps list-unstyled mb-0">
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-map-pin"></i></span>
            <div>
              <strong>Finden</strong>
              <p class="text-secondary mb-0">Suche einen Cache in deiner Nähe und navigiere mit GPS zu den Koordinaten.</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-box-archive"></i></span>
            <div>
              <strong>Loggen</strong>
              <p class="text-secondary mb-0">Trage dich im physischen Logbuch ein und logge online deinen Fund.</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-star"></i></span>
            <div>
              <strong>Verstecken</strong>
              <p class="text-secondary mb-0">Lege selbst einen Cache an und teile deine Lieblingsorte mit der Community.</p>
            </div>
          </li>
          <li>
            <span class="oc-step-icon"><i class="fa-solid fa-users"></i></span>
            <div>
              <strong>Mitmachen</strong>
              <p class="text-secondary mb-0">OpenCaching ist offen, kostenlos und vollständig in der Hand der Community.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

  </div>

  {# Center column #}
  <div class="oc-home-main">
    <div class="card oc-card h-100">
      <div class="card-body d-flex flex-column align-items-center justify-content-center text-center gap-4 py-5">

        <div>
          <div class="oc-home-title">OpenCaching</div>
          <div class="oc-home-subtitle text-secondary">
            Das offene Geocaching-Netzwerk — kostenlos, frei, von der Community getragen.
          </div>
        </div>

        <div class="oc-stats-row">
          <div class="oc-stat">
            <span class="oc-stat-number">{{ cacheCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">Aktive Caches</span>
          </div>
          <div class="oc-stat-divider"></div>
          <div class="oc-stat">
            <span class="oc-stat-number">{{ logCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">Logeinträge</span>
          </div>
          <div class="oc-stat-divider"></div>
          <div class="oc-stat">
            <span class="oc-stat-number">{{ userCount|number_format(0, ',', '.') }}</span>
            <span class="oc-stat-label">Mitglieder</span>
          </div>
        </div>

        <div class="d-flex gap-3 flex-wrap justify-content-center">
          <a href="/livemap" class="btn btn-primary btn-lg px-4">
            <i class="fa-solid fa-map me-2"></i>Zur Karte
          </a>
          <a href="/caches/" class="btn btn-outline-primary btn-lg px-4">
            <i class="fa-solid fa-magnifying-glass me-2"></i>Caches suchen
          </a>
        </div>

        <p class="text-secondary mb-0 mt-2" style="max-width: 480px; font-size: 0.9rem;">
          OpenCaching setzt keine proprietären Karten-APIs ein. Die Live-Karte läuft auf
          OpenStreetMap — offen, kostenlos, ohne API-Schlüssel.
        </p>

      </div>
    </div>
  </div>

  {# Right column #}
  <div class="oc-home-side">

    {# Tall card #}
    <div class="card oc-card mb-3">
      <div class="card-header fw-bold">
        <i class="fa-solid fa-shield-halved me-1"></i> Warum OpenCaching?
      </div>
      <div class="card-body">
        <ul class="list-unstyled oc-why-list mb-0">
          <li><i class="fa-solid fa-check text-success me-2"></i>Keine Google-Abhängigkeit</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>Komplett kostenlos — keine Premium-Tarife</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>Offene Daten, offener Code</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>Kein Tracking, keine Werbung</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>DSGVO-konform, Server in Deutschland</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>API für alle — offen dokumentiert</li>
          <li><i class="fa-solid fa-check text-success me-2"></i>Dark Mode &amp; Mobile-Support</li>
        </ul>
      </div>
    </div>

    {# Short card #}
    <div class="card oc-card">
      <div class="card-body text-center py-4">
        <i class="fa-solid fa-earth-europe fa-2x mb-3" style="color: var(--oc-primary);"></i>
        <p class="mb-0 text-secondary" style="font-size: 0.9rem; line-height: 1.5;">
          OpenCaching ist Teil eines weltweiten Netzwerks unabhängiger Geocaching-Plattformen.
        </p>
      </div>
    </div>

  </div>

</div>
{% endblock %}
