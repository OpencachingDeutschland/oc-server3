{% extends 'base.html.twig' %}

{% block data_page %}map3{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/map.css') }}">
    <style>
        body {
            overflow: hidden;
            height: 100vh;
        }
        main.content {
            padding: 0 !important;
            margin: 0 !important;
            overflow: hidden;
            min-height: 0;
        }
        #mapRoot {
            width: 100%;
            height: calc(100vh - var(--oc-navbar-height));
            margin: 0;
            padding: 0;
            border: none;
        }
        footer {
            display: none !important;
        }
        .map-toast {
            display: none;
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            padding: 8px 16px;
            background: rgba(47, 125, 199, 0.92);
            color: #fff;
            font-size: 14px;
            font-weight: bold;
            border-radius: 6px;
            white-space: nowrap;
            pointer-events: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
    </style>
{% endblock %}

{% block page_content %}
    <div id="mapRoot"
         data-init-lat="{{ initLat }}"
         data-init-lon="{{ initLon }}"
         data-init-zoom="{{ initZoom }}"></div>
{% endblock %}
