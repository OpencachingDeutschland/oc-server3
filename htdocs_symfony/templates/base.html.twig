<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    {% block head %}
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    {% endblock %}

    <title>{% block title %}Geocaching mit Opencaching.de{% endblock %}</title>

    {% block stylesheets %}
        <style>
        /* Grund-Setup für volle Höhe */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: grid;
            /* Definiert die Zeilen: oben auto, mitte nimmt Rest, unten auto */
            grid-template-rows: auto 1fr auto;
            /* Definiert die Spalten: links 100px, rechts nimmt Rest */
            grid-template-columns: 260px 1fr;
            min-height: 100vh;
            font-family: sans-serif;
        }

        .header {
            grid-column: 1 / 3;
            background-color: #333;
            color: white;
            padding: 20px;
            text-align: center;
        }

        .sidebar {
            background-color: #f4f4f4;
            padding: 20px;
            border-right: 1px solid #ddd;
        }

        .content {
            background-color: #fff;
            padding: 20px;
        }

        .footer {
            grid-column: 1 / 3;
            background-color: #333;
            color: white;
            padding: 20px;
            text-align: center;
        }

        /* Responsive Anpassung für schmale Bildschirme (z.B. Smartphones) */
        @media (max-width: 600px) {
            body {
                grid-template-columns: 1fr; /* Nur noch eine Spalte */
            }

            .header, .sidebar, .content, .footer {
                grid-column: 1 / 2; /* Alle Elemente nutzen die volle Breite */
            }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid #ddd;
            }
        }

    </style>
    {% endblock %}
</head>

<body {% block body_start %}{% endblock %}>
{% block after_body_start %}{% endblock %}

    <header class="header">
        {% block navbar_search_form %}
            <!-- SEARCH FORM -->
            <form class="form-inline ml-6">
                <div class="input-group mb-3">
                    <input class="form-control form-control-navbar" type="search" placeholder="Search" aria-label="Search"
                           aria-describedby="button-magnifier">
                    <div class="input-group-append">
                        <span class="input-group-text" id="button-magnifier">&#x1F50D;</i></span>
                    </div>
                </div>
            </form>
        {% endblock %}
    </header>

    <aside class="sidebar">
        {% block sidebar_user %}
            {% if app.user is not null and is_granted('IS_AUTHENTICATED_FULLY') %}
                {#                    {% include '@AdminLTE/Sidebar/user-panel.html.twig' with {'adminlte_direct_include': true} %}#}
            {% endif %}
        {% endblock %}

        {% block sidebar_search %}
        {% endblock %}

        {% block sidebar_nav %}
            {{ knp_menu_render('main') }}
        {% endblock %}
    </aside>

    {% block page_content_before %}{% endblock %}
    <main class="content">
        {% block page_title %}{% endblock %}
        <small>{% block page_subtitle %}{% endblock %}</small>

        {% block page_content_start %}{% endblock %}
        {% block page_content %}{% endblock %}
        {% block page_content_end %}{% endblock %}

    </main>
    {% block page_content_after %}{% endblock %}

    {% block footer %}
        <footer class="footer">
            <a href="#">{{ 'Privacy policy' | trans }}</a>
            ,
            <a href="#">{{ 'Imprint' | trans }}</a>
            ,
            <a href="#">{{ 'Contact' | trans }}</a>
            ,
            &#xA9; opencaching.de {{ "now" | date("Y") }}
        </footer>
    {% endblock %}

</body>
</html>
