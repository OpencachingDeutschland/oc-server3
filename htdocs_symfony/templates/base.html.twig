<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <script>
        (function() {
            var stored = localStorage.getItem('oc-theme');
            var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var theme = stored || (systemDark ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    {% block head %}
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    {% endblock %}

    <title>{% block title %}Geocaching mit Opencaching.de{% endblock %}</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('css/oc-style.css') }}">

    {% block stylesheets %}
        <style>
        * {
            box-sizing: border-box;
        }

        body {
            display: grid;
            grid-template-rows: auto 1fr auto;
            min-height: 100vh;
            font-family: sans-serif;
        }

        .content {
            background-color: var(--oc-bg-body);
            color: var(--oc-text-primary);
            padding: 20px;
        }

        .footer {
            background-color: var(--oc-bg-navbar);
            color: var(--oc-text-inverse);
            padding: 20px;
            text-align: center;
        }

        .footer a {
            color: var(--oc-footer-link-color);
        }
        </style>
    {% endblock %}
</head>

{# Pages override the `data_page` block to pick the page module under public/js/pages/<data_page>.js #}
<body data-page="{% block data_page %}{% endblock %}" {% block body_start %}{% endblock %}>
{% block after_body_start %}{% endblock %}

    <header class="header">
        <nav class="navbar navbar-expand-lg navbar-dark w-100" style="background-color: var(--oc-bg-navbar);">
            <div class="container-fluid">
                <a class="navbar-brand p-0" href="/"><img src="{{ asset('images/oclogo.png') }}" alt="Opencaching.de" height="40" style="display:block;"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    {% block navbar_nav %}
                        {{ knp_menu_render('sideMenu', {'template': 'bootstrap_navbar_menu.html.twig'}) }}
                    {% endblock %}
                </div>

                <button class="theme-toggle ms-2" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
                    <span class="theme-icon-light">&#9788;</span>
                    <span class="theme-icon-dark">&#9789;</span>
                </button>
            </div>
        </nav>
    </header>

    {% block page_content_before %}{% endblock %}
    <main class="content">
        {% block page_title %}{% endblock %}
        <small>{% block page_subtitle %}{% endblock %}</small>

        {% block page_content_start %}{% endblock %}
        {% block page_content %}{% endblock %}
        {% block page_content_end %}{% endblock %}

    </main>
    {% block page_content_after %}{% endblock %}

    {% block footer %}
        <footer class="footer">
            <a href="#">{{ 'Privacy policy' | trans }}</a>
            ,
            <a href="#">{{ 'Imprint' | trans }}</a>
            ,
            <a href="#">{{ 'Contact' | trans }}</a>
            ,
            &#xA9; opencaching.de {{ "now" | date("Y") }}
        </footer>
    {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="{{ asset('js/app.js') }}"></script>
    <script>
        (function() {
            var btn = document.getElementById('themeToggle');
            if (!btn) return;
            btn.addEventListener('click', function() {
                var current = document.documentElement.getAttribute('data-theme') || 'light';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('oc-theme', next);
            });
        })();
    </script>
</body>
</html>
