{% extends 'base.html.twig' %}

{% block i18n %}<script>Object.assign(window.OCI18n, {{ {
    'User ID':        'User ID'        | trans,
    'Email':          'Email'          | trans,
    'Joined':         'Joined'         | trans,
    'Last login':     'Last login'     | trans,
    'Finds':          'Finds'          | trans,
    'Hides':          'Hides'          | trans,
    'Country':        'Country'        | trans,
    'Email valid':    'Email valid'    | trans,
    'Status':         'Status'         | trans,
    'Active':         'Active'         | trans,
    'Account info':   'Account info'   | trans,
    'Profile':        'Profile'        | trans,
} | json_encode | raw }});</script>{% endblock %}

{% block page_content %}
<div class="container-fluid py-3">

    {% if user_by_id is defined and user_by_id %}
        <div class="row mb-4">
            <div class="col-12 col-md-8">
                <h3 class="mb-1">{{ user_by_id.username }}</h3>
                <p class="text-secondary small">{{ 'Profile' | trans }}</p>
            </div>
        </div>

        <div class="row">
            {# Public Info #}
            <div class="col-12 col-md-6">
                <div style="background: var(--oc-bg-surface); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                    <h5 class="mb-3">{{ 'Profile' | trans }}</h5>
                    <dl class="row g-2 mb-0">
                        <dt class="col-sm-4 text-secondary">{{ 'Username' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.username }}</dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Finds' | trans }}:</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">{{ user_by_id.findCount ?? 0 }}</span></dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Hides' | trans }}:</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">{{ user_by_id.hideCount ?? 0 }}</span></dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Country' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.country ?? '—' }}</dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Joined' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.dateCreated | date('d.m.Y') }}</dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Last login' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.lastLogin | date('d.m.Y') }}</dd>
                    </dl>
                </div>
            </div>

            {# Team-only info #}
            {% if is_granted('ROLE_TEAM') %}
            <div class="col-12 col-md-6">
                <div style="background: var(--oc-bg-surface); padding: 1rem; border-radius: 0.5rem; margin-bottom: 1rem;">
                    <h5 class="mb-3">{{ 'Account info' | trans }}</h5>
                    <dl class="row g-2 mb-0">
                        <dt class="col-sm-4 text-secondary">{{ 'User ID' | trans }}:</dt>
                        <dd class="col-sm-8"><code>{{ user_by_id.userId }}</code></dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Email' | trans }}:</dt>
                        <dd class="col-sm-8"><code>{{ user_by_id.email }}</code></dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Email valid' | trans }}:</dt>
                        <dd class="col-sm-8">
                            {% if user_by_id.emailProblems %}
                                <span class="badge bg-danger">✗</span>
                            {% else %}
                                <span class="badge bg-success">✓</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Status' | trans }}:</dt>
                        <dd class="col-sm-8">
                            {% if user_by_id.isActive %}
                                <span class="badge bg-success">{{ 'Active' | trans }}</span>
                            {% else %}
                                <span class="badge bg-danger">Inactive</span>
                            {% endif %}
                        </dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Created' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.dateCreated | date('d.m.Y H:i') }}</dd>

                        <dt class="col-sm-4 text-secondary">{{ 'Modified' | trans }}:</dt>
                        <dd class="col-sm-8">{{ user_by_id.lastModified | date('d.m.Y H:i') }}</dd>
                    </dl>
                </div>
            </div>
            {% endif %}
        </div>

    {% else %}
        <div class="alert alert-warning">
            <strong>{{ 'No user found' | trans }}</strong>
        </div>
    {% endif %}

</div>
{% endblock %}
